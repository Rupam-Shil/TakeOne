{
  "name": "studio-clone",
  "productName": "Studio Clone",
  "version": "1.0.0",
  "description": "Studio Clone records your screen and turns it into a polished demo: automatic zooms, a smooth cursor, backgrounds, captions, voiceovers and fast exports.",
  "author": "Rupam Shil",
  "homepage": "https://github.com/Rupam-Shil/studio-clone",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rupam-Shil/studio-clone.git"
  },
  "bugs": {
    "url": "https://github.com/Rupam-Shil/studio-clone/issues"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "build:native": "bash native/build.sh",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac --arm64",
    "share-server": "node share-server/server.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "immer": "^11.1.21",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.60.0",
    "mediabunny": "^1.61.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "dev.studioclone.app",
    "productName": "Studio Clone",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Studio Clone records your camera for the webcam overlay.",
        "NSMicrophoneUsageDescription": "Studio Clone records your microphone for narration.",
        "NSAudioCaptureUsageDescription": "Studio Clone records system audio.",
        "NSScreenCaptureUsageDescription": "Studio Clone records your screen.",
        "LSUIElement": false
      },
      "fileAssociations": [
        {
          "ext": "studioclone",
          "name": "Studio Clone Project",
          "role": "Editor",
          "isPackage": true
        },
        {
          "ext": "studiopreset",
          "name": "Studio Clone Preset",
          "role": "Editor",
          "isPackage": true
        }
      ]
    }
  }
}
